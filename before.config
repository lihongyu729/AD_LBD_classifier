
meta_learning:
  three_loyal_strategies:
    optimizer_strategy:
      name: anil
      enable: true
      params:
        inner_lr: 0.008
        inner_steps: 5
        first_order: true
        dropout: 0.05
        label_smoothing: 0.02
        inner_label_smoothing: 0.02
        focal_weight: 0.05
        focal_gamma: 0.9
        use_class_weights: false
        inner_use_class_weights: false
        max_inner_lr: 0.05
        supcon_weight: 0.15
        supcon_temperature: 0.1
    metric_strategy:
      name: protonet
      enable: false
      params:
        metric: cosine
        proj_dim: 16
        gamma: 0.0
        temperature: 15.0
        label_smoothing: 0.02
    hybrid_strategy:
      name: hybrid
      enable: false
      params:
        opt_weight: 0.5
        metric_weight: 0.5
        scheduler: linear
task:
  n_way: 2
  k_shot: 4
  q_query: 4
  train_episodes_override: 0
  min_train_episodes: 40
  max_train_episodes: 110
  max_minority_reuse_per_epoch: 5.0
  min_epoch_coverage_ratio: 0.9
  val_episodes_meta: 140
  allow_unsafe_episode_override: false
ss3m:
  embed_dim: 768
  depth: 6
  patch_size:
  - 16
  - 16
  - 16
  branch_types:
  - conv
  - mamba
  use_checkpoint: true
  dropout: 0.0
  use_pos_emb: true
  merge_type: softmax
input:
  shape_dhw:
  - 112
  - 112
  - 112
model:
  embed_dim: 768
  depth: 6
  patch_size:
  - 16
  - 16
  - 16
classifier:
  backbone: medmamba_ss3m
  epochs: 200
  batch_size: 4
  lr: 8.0e-05
  weight_decay: 0.01
  freeze_backbone: false
  warmup_epochs: 10
  lr_scheduler: cosine
  lr_factor: 0.5
  lr_patience: 8
  label_smoothing: 0.01
  ema_decay: 0.999
  max_grad_norm: 1.0
  grad_accum_steps: 1
  pretrained_path: ~/MRI/classifer/out/best_mae_8dir_768dim.pth
  use_class_weights: false
  freeze_bn: false
  backbone_norm: batchnorm
  backbone_norm_groups: 8
  head_type: linear
  head_temperature: 1.0
  head_hidden_dim: 256
  head_dropout: 0.06
  head_activation: silu
  backbone_n_dirs_train: 8
  backbone_use_dual_branch: true
  backbone_lr_ratio: 0.06
  pretrained_failfast_min_ratio: 0.1
  pretrained_warn_ratio: 0.3
  pretrained_auto_scan_siblings: true
  pretrained_auto_scan_max_files: 12
  pretrained_prefer_mae_names: true
metrics:
- acc
- auc
- f1_macro
- f1_weighted
- precision_macro
- recall_macro
- confusion_matrix
early_stopping:
  patience: 40
  min_delta: 0.001
  monitor: val_raw_auc
  min_lbd_sens: 0.55
  gate_blocking: false
imbalance:
  mode: auto
  class_weight_mode: effective_num
  class_weight_beta: 0.995
  respect_episode_balance: true
  balanced_episode_focal_weight: 0.02
thresholding:
  allow_tuned_early_stop: false
  calib_fraction: 0.2
  split_seed: 42
logging:
  tensorboard: false
debug:
  enabled: false
  epochs: 1
  folds: 1
stability:
  safe_mode: false
  cudnn_benchmark: true
  cudnn_deterministic: false
dataset:
  folder_label_map:
    AD: 0
    LBD: 1
  allowed_labels:
  - AD
  - LBD
  num_workers: 4
  use_weighted_sampler: false
  label_map:
    AD: 0
    LBD: 1
  label_column_path: path
  label_column_class: label
  folder_file_exts:
  - .nii
  - .nii.gz
  folder_require_substring: null
preprocess_cache:
  enabled: true
  cache_dir: ~/MRI/pretrain/code/meta/cache
augment:
  enable: true
  flip_p: 0.3
  noise_std: 0.02
  gamma_jitter: 0.08
  cutout_p: 0.08
  cutout_frac: 0.08
paths:
  out_dir: ~/MRI/pretrain/code/meta/out
  label_roots:
    AD: ~/split_1mm_112/AD
    LBD: ~/split_1mm_112/LBD
    MCI: ~/split_1mm_112/MCI
cv:
  cv_n_splits: 5
  run_folds: 5
  cv_shuffle: true
  cv_random_state: 42
  stratified: true
  sample_fraction: 1.0
  quick_folds: 2
device:
  force: cuda
  cuda_device: 0
